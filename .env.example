# Brain Console dev credentials (Phase G, 2026-07-20).
#
# These are PLACEHOLDERS for new deployments — never commit real values here.
# Copy this file to `.env` (gitignored) and replace before `docker compose up`.
#
# docker-compose.yml reads these via `${BRAIN_USERNAME:-}` /
# `${BRAIN_PASSWORD:-}` substitution and forwards them into the container's
# `environment:` block. The Rust server reads them at startup via
# `std::env::var` (default env-var names; can be overridden via
# `console_dev_bootstrap_username_env` / `console_dev_bootstrap_password_env`
# in `[serve]` if you prefer different keys).
#
# IMPORTANT: env-var names are namespaced as `BRAIN_*` (not bare
# `USERNAME`/`PASSWORD`) because bare `USERNAME` collides with the Windows
# built-in env var (always set to the host user's login name), which silently
# overrides `.env` via docker-compose substitution. Found live 2026-07-20.
#
# Tradeoff: env-var credentials land in `docker inspect Config.Env`.
# Acceptable for dev-grade auth behind a loopback-only publish + a TLS
# fronting proxy. For higher-stakes deployments, restore the legacy
# `console_dev_bootstrap_secret_file` Docker-secret path and unset
# BRAIN_PASSWORD — the server falls back to the bind-mounted file
# (mode 0600 on the host).
BRAIN_USERNAME=console-admin
BRAIN_PASSWORD=change-me-in-production

# MCP Bearer tokens — required when exposing /mcp beyond loopback.
# Comma-separated; each MCP client (Claude Desktop, Cursor, scripts) gets
# its own token so a leaked token can be rotated per-client.
# Generate tokens with: openssl rand -hex 32
# Example: BRAIN_MCP_TOKENS=token-for-claude,token-for-cursor,token-for-scripts
# Empty/unset is allowed only when http_bind_all_interfaces=false (loopback);
# public bind + empty = server refuses to start (fail-closed).
BRAIN_MCP_TOKENS=

# AI provider key for brain_extract / brain_propose (optional). Leave blank
# to disable AI features.
ZAI_API_KEY=
