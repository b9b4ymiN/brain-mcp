# Brain Console dev credentials (Phase G, 2026-07-20).
#
# These are PLACEHOLDERS for new deployments — never commit real values here.
# Copy this file to `.env` (gitignored) and replace before `docker compose up`.
#
# docker-compose.yml reads these via `${USERNAME:-}` / `${PASSWORD:-}`
# substitution and forwards them into the container's `environment:` block.
# The Rust server reads them at startup via `std::env::var` (default env-var
# names; can be overridden via `console_dev_bootstrap_username_env` /
# `console_dev_bootstrap_password_env` in `[serve]` if you prefer different
# keys).
#
# Tradeoff: env-var credentials land in `docker inspect Config.Env`. Acceptable
# for dev-grade auth behind a loopback-only publish + a TLS fronting proxy.
# For higher-stakes deployments, restore the legacy
# `console_dev_bootstrap_secret_file` Docker-secret path and unset PASSWORD —
# the server falls back to the bind-mounted file (mode 0600 on the host).
USERNAME=console-admin
PASSWORD=change-me-in-production

# AI provider key for brain_extract / brain_propose (optional). Leave blank
# to disable AI features.
ZAI_API_KEY=
